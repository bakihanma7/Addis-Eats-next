# Copy to .env.local and fill in. .env.local is gitignored; this file is committed
# and must only ever contain dummy values.

# Signs the session cookie. Required in production (the app refuses to start
# without it). Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-string

# Optional. Domain registered with Plausible analytics. Leave empty to load no
# third-party script at all. When set, the script loads with strategy="lazyOnload".
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Public address of the deployed site, no trailing slash. Used for canonical
# links, og:image, JSON-LD, sitemap.xml and robots.txt (they must be absolute
# URLs). Required in production, or they will point at localhost.
SITE_URL=https://addis-eats.example.com
